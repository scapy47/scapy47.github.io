---
import Layout from "@layouts/Layout.astro";
import Hacktxt from "@/components/react/ui/Hacktxt";
import { Icon } from "astro-icon/components";

const info = {
  year: new Date().getFullYear(),
};
---

<style>
  .transition-all {
    transition: all 0.8s cubic-bezier(0.86, 0, 0.14, 1);
  }
</style>

<script>
  const btn = document.querySelector("#navigationBtn") as HTMLButtonElement;
  const el = document.querySelector("#navigation") as HTMLDivElement;

  btn.onclick = () => {
    navigator.vibrate(100);

    el.style.width =
      el.style.width === "fit-content" ? "calc(100% - 2rem)" : "fit-content";
  };
</script>

<Layout theme="black">
  <nav
    id="navigation"
    class="border-crimson corner-bevel shadow-center bg-crimson/35 fixed right-4 bottom-4 h-16 w-fit overflow-hidden rounded-tl-4xl rounded-br-4xl border-2 mix-blend-difference backdrop-blur-3xl transition-all lg:top-4"
  >
    <button
      class="grid w-full cursor-pointer place-items-center"
      id="navigationBtn"
      ><Icon
        class={"text-orange-400"}
        name="line-md:compass-twotone-loop"
        size={60}
      /></button
    >
    <ul class="flex justify-end px-6 text-4xl">
      <li><a href="/notes"><Hacktxt text="Notes" client:idle /></a></li>
    </ul>
  </nav>

  <main class="flex h-lvh items-center justify-center bg-black">
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 z-50 h-fit w-fit animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
      <p class="hover:text-crimson text-2xl text-gray-400">
        <a href="https://psychopass.fandom.com/wiki/Crime_Coefficient_(Index)"
          >CRIME COEFFICIENT:</a
        >
      </p>
      <Hacktxt className="text-6xl font-extralight" text="0.00" client:load />
      <Hacktxt className="text-4xl font-extralight" text=" -0" client:load />
      <p class="text-2xl text-gray-400">TARGET:</p>
      <p class="text-xl">Not Target</p>
    </div>
  </main>

  <section class="h-lvh w-full bg-yellow-300"></section>
  <section class="h-lvh w-full bg-blue-300"></section>
  <section class="h-lvh w-full bg-pink-300"></section>

  <footer class="flex w-full items-center justify-center bg-black">
    <p>Copyright (c) {info.year} Author. All Rights Reserved.</p>
  </footer>
</Layout>

<Layout theme="black">
  <nav
    id="navigation"
    class="border-crimson corner-bevel shadow-center bg-crimson/35 fixed right-4 bottom-4 z-50 h-16 w-3/12 overflow-hidden rounded-tl-4xl rounded-br-4xl border-2 font-mono font-bold mix-blend-difference backdrop-blur-3xl lg:top-4 lg:w-2/12"
  >
    <button
      title="show navigations"
      class="mb-6 grid w-full cursor-pointer place-items-center bg-cyan-400/10"
      id="navigationBtn"
      ><Icon
        class={"icon-a text-electric-orange"}
        name="line-md:compass-twotone-loop"
        size={60}
      />
      <Icon
        class={"icon-b hidden text-electric-orange"}
        name="line-md:close"
        size={60}
      />
    </button>
    <ul class="flex flex-col items-end px-6 text-7xl">
      {
        [
          ["Home", "/"],
          ["Notes", "/notes"],
          ["Tools", "/tools"],
        ].map((e) => (
          <li>
            <a
              class="active:text-electric-orange hover:text-crimson pointer-events-auto"
              href={e[1]}
            >
              <Hacktxt text={e[0]} client:idle />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <main class="flex h-svh items-center justify-center">
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 z-10 h-fit w-fit animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
      <p class="hover:text-electric-orange text-2xl text-gray-400">
        <a href="https://psychopass.fandom.com/wiki/Crime_Coefficient_(Index)"
          >CRIME COEFFICIENT:</a
        >
      </p>
      <Hacktxt className="text-6xl font-extralight" text="0.00" client:load />
      <Hacktxt className="text-4xl font-extralight" text=" -0" client:load />
      <p class="text-2xl text-gray-400">TARGET:</p>
      <p class="text-xl">Not Target</p>
    </div>

    <!-- <Background client:idle /> -->
    <div
      class="absolute h-svh w-full overflow-hidden text-9xl font-extrabold [--duration:20s]"
    >
      <Carousel
        rep={6}
        className="border-electric-orange text-electric-orange absolute top-2/6 right-3/12 w-[hypot(100%,100%)] -rotate-45 transform border-2"
      >
        <Icon name="line-md:chevron-triple-left" />
        <Icon name="line-md:hazard-lights-loop" />
        <span>47</span>
        <Icon name="line-md:hazard-lights-loop" />
        <Icon name="line-md:chevron-triple-right" />
      </Carousel>

      <Carousel
        rep={6}
        className="border-electric-orange text-electric-orange absolute top-4/6 left-3/12 w-[hypot(100%,100%)] -rotate-45 transform border-2"
      >
        <Icon name="line-md:chevron-triple-left" />
        <Icon name="line-md:hazard-lights-loop" />
        <span>47</span>
        <Icon name="line-md:hazard-lights-loop" />
        <Icon name="line-md:chevron-triple-right" />
      </Carousel>

      <Carousel
        rep={6}
        className="border-electric-orange text-electric-orange absolute bottom-3/6 left-2/12 w-[hypot(100%,100%)] rotate-45 transform border-2"
      >
        <Icon name="line-md:chevron-triple-left" />
        <Icon name="line-md:hazard-lights-loop" />
        <span>47</span>
        <Icon name="line-md:hazard-lights-loop" />
        <Icon name="line-md:chevron-triple-right" />
      </Carousel>

      <Carousel
        rep={6}
        className="border-electric-orange text-electric-orange absolute right-3/12 bottom-2/6 w-[hypot(100%,100%)] rotate-45 transform border-2"
      >
        <Icon name="line-md:chevron-triple-left" />
        <Icon name="line-md:hazard-lights-loop" />
        <span>47</span>
        <Icon name="line-md:hazard-lights-loop" />

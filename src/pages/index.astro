<Layout theme="black">
  <nav
    id="navigation"
    class="border-crimson corner-bevel shadow-center bg-crimson/35 fixed right-4 bottom-4 z-50 h-16 w-3/12 overflow-hidden rounded-tl-4xl rounded-br-4xl border-2 font-mono font-bold mix-blend-difference backdrop-blur-3xl lg:top-4 lg:w-2/12"
  >
    <button
      title="show navigations"
      class="mb-6 grid w-full cursor-pointer place-items-center bg-cyan-400/10"
      id="navigationBtn"
      ><Icon
        class={"icon-a text-crimson"}
        name="line-md:compass-twotone-loop"
        size={60}
      />
      <Icon
        class={"icon-b hidden text-crimson"}
        name="line-md:close"
        size={60}
      />
    </button>
    <ul class="flex flex-col items-end px-6 text-7xl">
      {
        [
          ["Home", "/"],
          ["Notes", "/notes"],
          ["Tools", "/tools"],
        ].map((e) => (
          <li>
            <a
              class="active:text-crimson hover:text-crimson pointer-events-auto"
              href={e[1]}
            >
              <Hacktxt text={e[0]} client:idle />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <main class="flex h-lvh items-center justify-center dark:bg-black">
    <div id="bg" class="absolute inset-0 h-full w-full"></div>
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 h-fit w-fit animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
      <p class="hover:text-crimson text-2xl text-gray-400">
        <a href="https://psychopass.fandom.com/wiki/Crime_Coefficient_(Index)"
          >CRIME COEFFICIENT:</a
        >
      </p>
      <Hacktxt className="text-6xl font-extralight" text="0.00" client:load />
      <Hacktxt className="text-4xl font-extralight" text=" -0" client:load />
      <p class="text-2xl text-gray-400">TARGET:</p>
      <p class="text-xl">Not Target</p>
    </div>
    <div>
      <Marquee>
        <span class="text-2xl font-extrabold">hello</span>
      </Marquee>
    </div>
  </main>

  <section class="my-6 grid h-lvh w-full grid-cols-6 grid-rows-6 gap-8 py-6">
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 col-start-1 col-end-4 row-start-1 row-end-4 h-full w-full animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
    </div>
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 col-start-7 col-end-4 row-start-5 row-end-2 h-full w-full animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
    </div>
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 col-start-1 col-end-4 row-start-7 row-end-4 h-full w-full animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
    </div>
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 col-start-7 col-end-4 row-start-7 row-end-5 h-full w-full animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
    </div>
    <div
      class="corner-br-bevel border-crimson shadow-center bg-crimson/15 col-start-7 col-end-4 row-start-1 row-end-2 h-full w-full animate-pulse rounded-br-4xl border-2 p-2 italic backdrop-blur-3xl"
    >
    </div>
  </section>

  <footer class="flex w-full items-center justify-center font-extrabold">
    <p>Copyright (c) {info.year} Author. All Rights Reserved.</p>
  </footer>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import Hacktxt from "@/components/react/ui/Hacktxt";

const year = new Date().getFullYear();
---

<Layout theme="black">
  <nav
    class="border-crimson corner-bevel wMode-vlr hover:wMode-normal shadow-center animate-expand fixed top-0 right-0 h-full w-fit animate-pulse rounded-tl-4xl rounded-bl-4xl border-2 px-6 hover:py-12"
  >
    <a class="text-xl" href="/notes">notes</a>
  </nav>

  <main class="h-lvh w-full bg-black flex justify-center items-center">
    <div
      class="corner-br-bevel border-crimson shadow-center z-50 h-fit w-fit animate-pulse rounded-br-4xl border-2 p-2 italic"
    >
      <p class="hover:text-crimson text-2xl text-gray-400">
        <a href="https://psychopass.fandom.com/wiki/Crime_Coefficient_(Index)"
          >CRIME COEFFICIENT:</a
        >
      </p>
      <Hacktxt className="text-6xl font-extralight" text="0.00" client:load />
      <span> </span>
      <Hacktxt className="text-4xl font-extralight" text="-0" client:load />
      <p class="text-2xl text-gray-400">TARGET:</p>
      <p class="text-xl">Not Target</p>
    </div>
  </main>

  <section class="h-lvh w-full bg-yellow-300"></section>
  <section class="h-lvh w-full bg-blue-300"></section>
  <section class="h-lvh w-full bg-pink-300"></section>

  <footer class="flex w-full items-center justify-center bg-black">
    <p>Copyright (c) {year} Author. All Rights Reserved.</p>
  </footer>

  <style>
    .animate-expand {
      transition: width 1s ease-in-out;
    }
  </style>
</Layout>

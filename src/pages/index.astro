---
import Layout from "@layouts/Layout.astro";
import Hacktxt from "@/components/preact/ui/Hacktxt";
import { Icon } from "astro-icon/components";
// import Background from "@components/svelte/ui/Background.svelte";
import Showcase from "@components/svelte/ui/Showcase.svelte";
// import Marquee from "@components/preact/ui/Marquee";
import Carousel from "@components/preact/ui/Carousel";
// import { cn } from "@/lib/utils";
---

<style>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap");

  #navigation {
    transition: all 0.8s cubic-bezier(0.86, 0, 0.14, 1);
  }

  .show-navigation {
    height: fit-content;
    width: calc(100% - 2rem);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.querySelector<HTMLButtonElement>("#navigationBtn");
    const el = document.querySelector<HTMLDivElement>("#navigation");

    const icon_a = document.querySelector<HTMLElement>(".icon-a");
    const icon_b = document.querySelector<HTMLElement>(".icon-b");

    const toggle_state = () => {
      if (!el || !icon_a || !icon_b) return;
      el.classList.toggle("show-navigation");
      el.ariaExpanded = el.ariaExpanded !== "true" ? "ture" : "";
      icon_a.style.display = icon_a.style.display !== "none" ? "none" : "";
      icon_b.style.display = icon_b.style.display !== "inline" ? "inline" : "";
    };

    btn?.addEventListener("click", () => {
      navigator?.vibrate(100);
      toggle_state();
    });
  });
</script>


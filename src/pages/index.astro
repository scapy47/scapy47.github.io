---
import Layout from "@layouts/Layout.astro";
import Hacktxt from "@/components/preact/ui/Hacktxt";
import { Icon } from "astro-icon/components";
import Marquee from "@/components/preact/ui/Marquee";
// import { cn } from "@/lib/utils";

const info = {
  year: new Date().getFullYear(),
};
---

<style>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap");

  #navigation {
    transition: all 0.8s cubic-bezier(0.86, 0, 0.14, 1);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    if (
      !(
        /Chrome/.test(navigator.userAgent) &&
        !/Edg|OPR|Brave/.test(navigator.userAgent)
      )
    ) {
      alert("your browser is not supported");
      throw new Error("browser is not supported");
    }

    const btn = document.querySelector("#navigationBtn") as HTMLButtonElement;
    const el = document.querySelector<HTMLDivElement>("#navigation");

    const icon_a = document.querySelector<HTMLElement>(".icon-a");
    const icon_b = document.querySelector<HTMLElement>(".icon-b");

    const toggle_state = () => {
      if (!el || !icon_a || !icon_b) return;
      el.style.width =
        el.style.width !== "calc(100% - 2rem)" ? "calc(100% - 2rem)" : "";

      el.style.height = el.style.height !== "fit-content" ? "fit-content" : "";

      icon_a.style.display = icon_a.style.display !== "none" ? "none" : "";
      icon_b.style.display = icon_b.style.display !== "inline" ? "inline" : "";
    };

    btn.addEventListener("click", () => {
      navigator.vibrate(100);
      toggle_state();
    });
  });
</script>

